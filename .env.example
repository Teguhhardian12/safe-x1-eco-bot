# X1 Testnet (Maculatus) RPC
X1_RPC_URL=https://maculatus-rpc.x1eco.com/
X1_CHAIN_ID=10778

# X1 testnet APIs
X1_API_BASE=https://testnet-api.x1eco.com
X1_SUBGRAPH_URL=https://ms.kod.af

# Loop config
LOOP_INTERVAL_SECONDS=3600
ACCOUNT_DELAY_SECONDS=10

# Slippage (basis points, 200 = 2%)
SLIPPAGE_BPS=200

# Gas
GAS_PRIORITY_FEE_GWEI=1.5

# Optional proxy (leave empty to disable)
# Examples:
#   socks5://user:pass@host:port
#   http://user:pass@host:port
PROXY_URL=

# Keystores directory (relative to repo root)
KEYSTORE_DIR=keystores

# Quest amounts as PERCENT of native X1T balance (not absolute).
# X1 testnet caps wallet balance at 500 X1T (faucet stops above that),
# so percent-based sizing keeps the wallet from filling up.
TRANSFER_PCT=2
SWAP_PCT=15
ADD_LIQUIDITY_PCT=15
